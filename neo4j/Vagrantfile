Vagrant.configure("2") do |config|
  # This host reports every localhost TCP connect probe as open even when the
  # port is bindable. Skip only Vagrant's false-positive collision probe;
  # VirtualBox still reports a real bind conflict when it creates the rule.
  if ENV["VAGRANT_SKIP_LOOPBACK_PORT_CHECK"] == "1"
    require "vagrant/util/is_port_open"
    module Vagrant::Util::IsPortOpen
      class << self
        alias_method :neo4j_original_port_check, :is_port_open? unless method_defined?(:neo4j_original_port_check)
        def is_port_open?(host, port)
          return false if host == "127.0.0.1"
          neo4j_original_port_check(host, port)
        end
      end
    end
  end

  config.vm.box = "bento/ubuntu-24.04"
  config.vm.box_version = "202510.26.0"
  config.ssh.insert_key = true

  config.vm.hostname = "neo4j"
  config.vm.network "forwarded_port", guest: 22, host: 2222, id: "ssh", host_ip: "127.0.0.1", auto_correct: true
  config.vm.network "forwarded_port", guest: 7474, host: 7474, host_ip: "127.0.0.1", auto_correct: true
  config.vm.network "forwarded_port", guest: 7687, host: 7687, host_ip: "127.0.0.1", auto_correct: true

  config.vm.provider "virtualbox" do |vb|
    vb.name = "neo4j-vagrant"
    vb.cpus = 2
    vb.memory = 4096
  end

  config.vm.synced_folder ".", "/vagrant", type: "virtualbox"

  config.vm.provision "shell",
    path: "provision.sh",
    env: { "NEO4J_PASSWORD" => ENV.fetch("NEO4J_PASSWORD", "neo4jpassword") }
end
